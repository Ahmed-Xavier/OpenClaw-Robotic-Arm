# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=

# Ollama LLM Service Configuration (defaults: http://127.0.0.1:11434, qwen3.5:4b)
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=

# OpenCode CLI agent (default: opencode binary, agent "army", 300 s timeout)
OPENCODE_BIN=
OPENCODE_AGENT=
OPENCODE_TIMEOUT_SECONDS=

# Robot Arm Flask REST Server URL (default: http://127.0.0.1:8765)
FLASK_URL=
