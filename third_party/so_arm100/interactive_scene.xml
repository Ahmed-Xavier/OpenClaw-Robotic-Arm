<mujoco model="so_arm100_interactive">
  <include file="so_arm100.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="cube_mat" rgba="0.9 0.2 0.2 1"/>
    <material name="green_cube_mat" rgba="0.2 0.8 0.3 1"/>
    <material name="yellow_cube_mat" rgba="0.95 0.8 0.1 1"/>
    <material name="sphere_mat" rgba="0.15 0.55 0.95 1"/>
    <material name="target_mat_right" rgba="0.2 0.8 0.3 0.5"/>
    <material name="target_mat_left" rgba="0.2 0.4 0.9 0.5"/>
    <material name="table_mat" rgba="0.5 0.5 0.5 1"/>

    <!-- AprilTag marker textures and materials -->
    <texture type="2d" name="apriltag_tex_0" file="assets/apriltags/tag36h11_0.png"/>
    <texture type="2d" name="apriltag_tex_1" file="assets/apriltags/tag36h11_1.png"/>
    <texture type="2d" name="apriltag_tex_2" file="assets/apriltags/tag36h11_2.png"/>
    <texture type="2d" name="apriltag_tex_3" file="assets/apriltags/tag36h11_3.png"/>
    <material name="apriltag_mat_0" texture="apriltag_tex_0"/>
    <material name="apriltag_mat_1" texture="apriltag_tex_1"/>
    <material name="apriltag_mat_2" texture="apriltag_tex_2"/>
    <material name="apriltag_mat_3" texture="apriltag_tex_3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" pos="0 0 -0.001" material="groundplane"/>

    <!-- Table (top surface at z=0) -->
    <geom name="table" type="box" size="0.45 0.30 0.01" pos="0 -0.20 -0.01" material="table_mat"/>

    <!-- Overhead camera looking straight down -->
    <camera name="top_camera" pos="0 -0.20 0.5" xyaxes="1 0 0 0 1 0" fovy="60"/>

    <!-- AprilTag markers (flat, non-colliding) -->
    <geom name="apriltag_0" type="box" size="0.02 0.02 0.0005" pos="-0.28 -0.07 0.0006" material="apriltag_mat_0" contype="0" conaffinity="0"/>
    <geom name="apriltag_1" type="box" size="0.02 0.02 0.0005" pos="0.28 -0.07 0.0006" material="apriltag_mat_1" contype="0" conaffinity="0"/>
    <geom name="apriltag_2" type="box" size="0.02 0.02 0.0005" pos="-0.28 -0.33 0.0006" material="apriltag_mat_2" contype="0" conaffinity="0"/>
    <geom name="apriltag_3" type="box" size="0.02 0.02 0.0005" pos="0.28 -0.33 0.0006" material="apriltag_mat_3" contype="0" conaffinity="0"/>

    <!-- Manipulatable Cube 1 (Red) -->
    <body name="red_cube" pos="0 -0.22 0.015">
      <joint type="free"/>
      <geom name="cube_geom" type="box" size="0.012 0.012 0.012" material="cube_mat" density="400"
            friction="2.0 0.1 0.005" solimp="2 1 0.01" solref="0.01 1"/>
    </body>

    <!-- Manipulatable Cube 2 (Green) -->
    <body name="green_cube" pos="-0.08 -0.22 0.015">
      <joint type="free"/>
      <geom name="green_cube_geom" type="box" size="0.012 0.012 0.012" material="green_cube_mat" density="400"
            friction="2.0 0.1 0.005" solimp="2 1 0.01" solref="0.01 1"/>
    </body>

    <!-- Manipulatable Cube 3 (Yellow) -->
    <body name="yellow_cube" pos="0 -0.26 0.015">
      <joint type="free"/>
      <geom name="yellow_cube_geom" type="box" size="0.012 0.012 0.012" material="yellow_cube_mat" density="400"
            friction="2.0 0.1 0.005" solimp="2 1 0.01" solref="0.01 1"/>
    </body>

    <!-- Manipulatable Sphere -->
    <body name="blue_sphere" pos="0.08 -0.22 0.014">
      <joint type="free"/>
      <geom name="sphere_geom" type="sphere" size="0.014" material="sphere_mat" density="400"
            friction="2.0 0.1 0.02" solimp="2 1 0.01" solref="0.01 1"/>
    </body>

    <!-- Target drop zones -->
    <site name="target_right" pos="0.15 -0.18 0.005" size="0.018 0.018 0.002" type="box" material="target_mat_right"/>
    <site name="target_left" pos="-0.15 -0.18 0.005" size="0.018 0.018 0.002" type="box" material="target_mat_left"/>
  </worldbody>
</mujoco>
